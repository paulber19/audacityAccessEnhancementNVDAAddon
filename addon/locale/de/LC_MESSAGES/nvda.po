#. Translators: message to user
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:170
msgid "Cannot update {name} - missing file or invalid file format"
msgstr ""
"{Name} kann nicht aktualisiert werden – fehlende Datei oder ungültiges "
"Dateiformat"

#. Translators: The title of the dialog
#. presented while an Addon is being updated.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:187
msgid "Updating"
msgstr "Aktualisiere"

#. Translators: The message displayed while an addon is being updated.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:189
msgid "Please wait while the add-on is being updated."
msgstr "Bitte warten Sie, während das Add-on aktualisiert wird."

#. Translators: The message displayed when an error occurs
#. when installing an add-on package.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:211
msgid "Failed to update {name} add-on"
msgstr "Das Add-on „{name}“ konnte nicht aktualisiert werden"

#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:255
msgid "{summary} - update"
msgstr "{summary} - aktualisieren"

#. Translators: message to user that the update service is temporarily in maintenance
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:268
msgid "The service is temporarily under maintenance. Please, try again later."
msgstr ""
"Der Dienst steht vorübergehend nicht zur Verfügung. Bitte versuchen Sie es "
"später noch einmal."

#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:295
msgid ""
"The update is not compatible with this version of NVDA. Minimum NVDA "
"version: {minYear}.{minMajor}, last tested: {testedYear}.{testedMajor}."
msgstr ""
"Das Update ist nicht mit dieser Version von NVDA kompatibel. Minimale NVDA-"
"Version: {minYear}.{minMajor}, zuletzt getestet: {testedYear}.{testedMajor}."

#. Translators: message to user to report a new version.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:356
#, python-format
msgid "New version%s is available. Do you want to download it now?"
msgstr "Neue Version%s ist verfügbar. Möchten Sie sie jetzt herunterladen?"

#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:360
msgid ""
"New version{0} is available.\n"
"But it is not compatible with this version of NVDA: minimum version requred "
"= {1}, last version tested  = {2}.\n"
"Do you want to ignore this incompatibility and still download it now?"
msgstr ""
"Neue Version {0} ist verfügbar.\\n\n"
"Es ist jedoch nicht mit dieser NVDA-Version kompatibel: Mindestversion "
"erforderlich = {1}, letzte getestete Version = {2}.\\n\n"
"Möchten Sie diese Inkompatibilität ignorieren und es trotzdem jetzt "
"herunterladen?"

#. Translators: message to user that add-on is up to date
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:381
#, python-format
msgid "You are up-to-date. %s is the latest version."
msgstr "Sie sind bereits auf dem aktuellen Stand. %s ist die neueste Version."

#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:388
msgid "Oops! There was a problem checking for updates. Please retry later"
msgstr ""
"Hoppla! Bei der Suche nach Updates ist ein Problem aufgetreten. Bitte "
"versuchen Sie es später noch einmal"

#. Translators: This is a label of a button appearing
#. on UpdateCheckResult dialog.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:543
msgid "&Yes"
msgstr "&Ja"

#. Translators: This is a label of a button appearing
#. on UpdateCheckResult dialog.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:548
msgid "&No"
msgstr "&NEIN"

#. Translators: The label of a button to remind the user later
#. about performing some action.
#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:553
msgid "&Later"
msgstr "&Später"

#: globalPlugins\audacityAccessEnhancement\updateHandler\update_check.py:557
msgid "Wha&t's new"
msgstr "Was ist neu"
